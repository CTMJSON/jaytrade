[Unit]
Description=Cloudflare Named Tunnel for JayTrade
After=network.target stock-simulator.service
Wants=stock-simulator.service

[Service]
Type=simple
User=<your-username>
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/<your-username>/.cloudflared/config.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
