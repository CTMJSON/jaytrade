[Unit]
Description=Stock Trading Simulator
After=network.target

[Service]
Type=simple
User=<your-username>
WorkingDirectory=/home/<your-username>/stock-simulator/server
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
# --max-old-space-size caps Node's heap; useful on memory-constrained devices (e.g. Raspberry Pi)
ExecStart=/usr/bin/node --max-old-space-size=192 index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
